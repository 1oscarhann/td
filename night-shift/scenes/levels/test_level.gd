@onready var flesh_back: TileMapLayer = $FleshBack
@onready var flesh_walls: TileMapLayer = $FleshWalls


func _ready() -> void:
	pacing = PACING_SCRIPT.new()
	pacing.name = "Pacing"
	pacing.level = self
	add_child(pacing)
	var tile_set := TileSetBuilder.build()
	_variants = TileSetBuilder.variant_count(tile_set)
	back_wall.tile_set = tile_set
	walls.tile_set = tile_set
	flesh_back.tile_set = tile_set
	flesh_walls.tile_set = tile_set
	_build()
	act0.setup(_tasks, panel, _after_power)
	act0.door_x = _door_pos.x
	ambience.stream = AudioDirector.get_stream("hum")
	ambience.volume_db = -80.0
	ambience.play()
	GameState.zone_changed.connect(_apply_zone)
	act0.power_changed.connect(func(_on): _apply_zone(GameState.zone, true))
	_apply_zone(GameState.zone, true)


func _process(delta: float) -> void:
	if GameState.player == null:
		return
	_update_silence(delta)
	# Random drips somewhere in the dark around you, underground only.
	# (Far-away calls and the other false alarms live in Pacing.)
	if GameState.zone < 1 or _silenced or pacing.is_silent():
		return
	_drip_timer -= delta
	if _drip_timer <= 0.0:
		_drip_timer = randf_range(2.5, 7.0)
		var p: Vector2 = GameState.player.global_position
		AudioDirector.play_at("drip", p + Vector2(randf_range(-220, 220), randf_range(-40, 0)), -12.0, 0.15)


func _update_silence(delta: float) -> void:
	var close := thing != null and thing.state != WedgedThing.State.DORMANT \
			and thing.global_position.distance_to(GameState.player.global_position) < SILENCE_RADIUS
	_silenced = close
	var normal: float = ZONE_HUM_DB.get(GameState.zone, -26.0)
	if pacing.in_safe:
		normal -= 6.0                # safe room: the bed softens
	var target := -80.0 if close or pacing.is_silent() else normal
	# Drop out fast, creep back slowly.
	var rate := 40.0 if close else 6.0
	ambience.volume_db = move_toward(ambience.volume_db, target, rate * delta)


## Where the CCTV man stands at each stage of the design doc's escalation.
func _setup_figure() -> void:
	_figure.stages = {
		"corner": [_door_pos + Vector2(-14, 0), "side"],          # far corner, half out of frame
		"crisps": [_shop_bits["crisps"] + Vector2(-12, 0), "side"],   # by the crisps, facing the shelf
		"counter": [_counter_pos + Vector2(17, 0), "side"],       # by the counter, where you stand
		# The doc's "next to the open panel" stage: the panel is in the basement
		# now, so he stands at the top of the basement stairs, facing them.
		"panel": [_main_stairs.position + Vector2(-12, 0), "side"],
		"facing": [_door_pos + Vector2(70, 0), "front"],          # facing the camera
	}


## Return trips: the shop is slightly different each time you come back up.
func apply_shop_changes(trip: int) -> void:
	if trip >= 1:
		_shop_bits["door"].set("ajar", true)              # "you left the door open"
		for t: ShopTask in _tasks:
			if t.task_id == "shelf":
				t.done = false                            # the crisps are back in the box
				t.enabled = false
				t.queue_redraw()
	if trip >= 2:
		_shop_bits["mop"].visible = false                 # the mop's downstairs now
		for t: ShopTask in _tasks:
			if t.task_id == "mop":
				t.done = false                            # and the spill is back
				t.enabled = false
				t.queue_redraw()
	if trip >= 3:
		_shop_bits["fridge"].set_power(true)              # humming and lit, with no power
	_apply_landmark_changes(trip)


## The four CCTV feeds (see CCTVView.setup). Shop floor framing puts the
## figure's spot right at the left edge, half out of frame. Easy to miss.
func cctv_feeds() -> Array:
	return [
		# Each feed is 320x180; zoom 1.67 = a 192x108 slice of the world.
		{"label": "CAM1 SHOP FLOOR", "pos": Vector2(_door_pos.x + 80.0, _door_pos.y - 52.0), "zoom": 5.0 / 3.0},
		{"label": "CAM2 TILL", "pos": _counter_pos + Vector2(0, -26), "zoom": 10.0 / 3.0},
		{"label": "CAM3 FORECOURT", "pos": _window_pos, "zoom": 5.0},
		{"label": "CAM4 STOREROOM", "pos": _main_stairs.position + Vector2(-78, -52), "zoom": 5.0 / 3.0},
	]


func apply_camera_limits(cam: Camera2D) -> void:
	cam.limit_left = 0
	cam.limit_top = 0
	cam.limit_right = size_tiles.x * TILE
	cam.limit_bottom = size_tiles.y * TILE


## After the player is caught: creatures go back to where they started.
func reset_creatures() -> void:
	for c in creatures.get_children():
		if c.has_method("reset"):
			c.reset()


# -------------------------------------------------------------------- building

func _build() -> void:
	var width := 0
	for row: String in MAP:
		width = maxi(width, row.length())
	size_tiles = Vector2i(width, MAP.size())

	for y in MAP.size():
		var row: String = MAP[y]
		for x in width:
			var ch := row[x] if x < row.length() else "#"
			var cell := Vector2i(x, y)
			match ch:
				"#", "%":
					_put(true, cell, _solid_tile_for(x, y))
				".", ",", ":", ";", "~":
					_put(false, cell, _back_edge(_wall_for_char(ch), cell))
				_:
					_put(false, cell, _back_edge(_background_for(row, x), cell))
					_place_marker(ch, cell)
	_fill_margin(width)
	descent.setup(self, _main_stairs)
	for d: Dictionary in DECOR:
		_place_decor(d)
	_build_foreground()
	_setup_figure()


## Flesh tiles go on their own layers, which carry the breathing shader.
func _put(solid: bool, cell: Vector2i, tile: int) -> void:
	var flesh := tile in FLESH_TILES
	var layer: TileMapLayer
	if solid:
		layer = flesh_walls if flesh else walls
	else:
		layer = flesh_back if flesh else back_wall
	layer.set_cell(cell, 0, _atlas(tile, cell))


func _place_decor(d: Dictionary) -> void:
	var cell: Vector2i = d.cell
	if not _is_open(cell.x, cell.y):
		push_warning("TestLevel: decor %s at %s is inside rock" % [d.type, cell])
		return
	var ceil_y := _ceiling_y(cell)
	var floor_y := _floor_y(cell)
	var x := float(cell.x * TILE)
	var y := ceil_y + float(d.get("below_ceiling", 0))
	if d.has("above_floor"):
		y = floor_y - float(d.above_floor)
	match d.type:
		"light":
			var light: Node2D = LIGHT_SCENE.instantiate()
			light.position = Vector2(x + TILE * 0.5, ceil_y)
			props.add_child(light)
		"window":
			var window: Node2D = WINDOW_SCENE.instantiate()
			window.position = Vector2(x + TILE * 0.5, (ceil_y + floor_y) * 0.5 - 8.0)
			_window_pos = window.position
			props.add_child(window)
		"tube", "vent":
			var hung: Node2D = (TUBE_SCENE if d.type == "tube" else VENT_SCENE).instantiate()
			hung.position = Vector2(x + TILE * 0.5, ceil_y)
			props.add_child(hung)
			if d.type == "vent":
				hung.add_to_group("vents")     # false alarms rattle these
		"hush":
			_place_trigger({"event": "hush"}, Vector2(x + TILE * 0.5, floor_y))
		"safe":
			pacing.add_safe_room(x, float(d.to_x) * TILE)
		"pipe":
			var pipe: Sprite2D = PIPE_SCENE.instantiate()
			pipe.position = Vector2(x, y)
			pipe.region_rect = Rect2(0, 0, (int(d.to_x) - cell.x) * TILE, 6)
			props.add_child(pipe)
		"cable":
			var fake: bool = d.get("creature", false)
			var cable: WallCable = (CABLE_CREATURE_SCENE if fake else CABLE_SCENE).instantiate()
			cable.position = Vector2(x, y)
			cable.end_point = Vector2((int(d.to_x) - cell.x) * TILE, 0)
			cable.sag = float(d.get("sag", 8))
			# Fake ones live with the creatures (reset on death) but draw like props.
			if fake:
				cable.z_index = -5
				creatures.add_child(cable)
			else:
				props.add_child(cable)
		"spiders":
			for i in int(d.get("count", 3)):
				var spider: Spider = SPIDER_SCENE.instantiate()
				spider.position = Vector2(x + TILE * 0.5 + randf_range(-20.0, 20.0), ceil_y)
				creatures.add_child(spider)
		"arm":
			var arm: CeilingArm = ARM_SCENE.instantiate()
			arm.harmless = d.get("harmless", false)
			if d.get("floor", false):
				# Up through a floor grate: walk over it in the dark and it has you.
				arm.from_floor = true
				arm.position = Vector2(x + TILE * 0.5, floor_y - 1.0)
				var gr := Sprite2D.new()
				gr.texture = load("res://art/props/grate.tres")
				gr.position = Vector2(x + TILE * 0.5, floor_y + 2.0)
				gr.z_as_relative = false
				gr.z_index = 1
				props.add_child(gr)
			else:
				arm.position = Vector2(x + TILE * 0.5, ceil_y + 4.0)   # just under the vent grille
			creatures.add_child(arm)
		"leg":
			var leg: LegTip = LEG_SCENE.instantiate()
			leg.position = Vector2(x + TILE * 0.5 + 3.0, ceil_y + 7.0)   # at the vent's lip
			creatures.add_child(leg)
		"sprite":
			var spr := Sprite2D.new()
			spr.texture = load("res://art/props/%s.tres" % d.name)
			spr.offset = Vector2(0, -spr.texture.get_height() * 0.5)
			spr.position = Vector2(x + TILE * 0.5, floor_y - float(d.get("above_floor", 0)))
			props.add_child(spr)
		"arrival":
			# The door you come through from the basement landing. It won't open
			# from this side.
			var adoor := _make_back_door(Vector2(x + TILE * 0.5, floor_y), "arrival_%d" % int(d.trip), "", "arrival", cell)
			descent.resume_points[int(d.trip)] = {
				"pos": adoor.position, "zone": int(d.zone),
				"thing_pos": Vector2(d.thing.x * TILE + TILE * 0.5, floor_y),
				"thing_active": bool(d.thing_active)}
		"upstairs":
			# A shaft going up from this cell to the rock above it.
			var top := ceil_y
			var st: Stairs = STAIRS_SCENE.instantiate()
			st.position = Vector2(x, top)
			st.width = TILE * 2
			st.height = floor_y - top
			st.exit_up = true
			st.trip = int(d.trip)
			descent.register_upstairs(st)
			props.add_child(st)
		"panel":
			var bp: BoardedPanel = PANEL_SCENE.instantiate()
			bp.position = Vector2(x, floor_y)
			bp.pushed_from_inside = d.get("pushed", false)
			props.add_child(bp)
		"lure":
			var lure: Lure = LURE_SCENE.instantiate()
			lure.mode = d.mode
			lure.cord = float(d.get("cord", 40))
			lure.position = Vector2(x + TILE * 0.5, ceil_y)
			creatures.add_child(lure)
		"monitor":
			var mon: Node2D = MONITOR_SCRIPT.new()
			mon.shop_view_pos = Vector2(_door_pos.x + 140.0, _door_pos.y - 52.0)
			mon.position = Vector2(x + TILE * 0.5, floor_y)
			props.add_child(mon)
		"hang":
			var hang := Sprite2D.new()
			hang.texture = load("res://art/props/%s.tres" % d.name)
			hang.offset = Vector2(0, hang.texture.get_height() * 0.5)
			hang.position = Vector2(x + TILE * 0.5, ceil_y)
			props.add_child(hang)
		"water":
			var wat := Sprite2D.new()
			wat.texture = load("res://art/props/water.tres")
			wat.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
			wat.region_enabled = true
			wat.region_rect = Rect2(0, 0, (int(d.to_x) - cell.x) * TILE, 3)
			wat.centered = false
			wat.position = Vector2(x, floor_y - 2.0)
			wat.z_as_relative = false
			wat.z_index = 1   # over the floor tiles
			props.add_child(wat)
		"worklight":
			var wl: PoweredProp = LIGHT_SCENE.instantiate()
			wl.position = Vector2(x + TILE * 0.5, ceil_y)
			if d.has("size"):
				wl.light_size = int(d.size)
			if d.has("energy"):
				wl.light_energy = float(d.energy)
			# Where the light pools (px below the tube): low enough to backlight
			# whatever walks past.
			wl.light_offset = Vector2(0, float(d.get("pool", 0)))
			props.add_child(wl)
			# Down here worklights run off their own supply: the power cut
			# upstairs doesn't touch them (only a lights-out lever does).
			wl.remove_from_group("powered")
			if d.get("reveals", false):
				# Bright enough to throw a silhouette: this light also touches
				# the creature layer (black Light Only shapes block it).
				wl._light.range_item_cull_mask |= GameState.LIGHT_CREATURES
			_worklights[d.id] = wl
		"glimpse":
			# The Thing, seen but not met (zone 2). See thing_glimpse.gd.
			var gl: WedgedThing = THING_SCENE.instantiate()
			gl.set_script(GLIMPSE_SCRIPT)
			gl.set("mode", d.mode)
			gl.set("trigger_x", float(d.get("trigger", 0)) * TILE)
			gl.set("to_x", float(d.get("to", 0)) * TILE)
			gl.position = Vector2(x + TILE * 0.5, floor_y)
			creatures.add_child(gl)
		"trigger":
			_place_trigger({"line": d.get("line", ""), "event": d.get("event", "")},
					Vector2(x + TILE * 0.5, floor_y))
		"sign":
			var sg: Node2D = SIGN_SCENE.instantiate()
			sg.set("text", d.text)
			sg.set("wrong", true)
			sg.position = Vector2(x + TILE * 0.5, cell.y * TILE + TILE * 0.5)
			props.add_child(sg)
			sg.add_to_group("signs")
		"squeeze":
			var sq: Node2D = SQUEEZE_SCRIPT.new()
			sq.position = Vector2(x, floor_y)
			sq.set("length", (int(d.to_x) - cell.x) * TILE)
			sq.set("room", floor_y - ceil_y)
			props.add_child(sq)
		"mop":
			var mop: Node2D = MOP_SCENE.instantiate()
			mop.position = Vector2(x + TILE * 0.5, floor_y)
			props.add_child(mop)
		"line":
			_place_trigger({"line": d.id}, Vector2(x + TILE * 0.5, floor_y))
		"checkpoint":
			_place_trigger({"checkpoint": true}, Vector2(x + TILE * 0.5, floor_y))
		"zonemark":
			_place_trigger({"zone": int(d.zone), "repeat": true}, Vector2(x + TILE * 0.5, floor_y))
		"backdoor":
			_make_back_door(Vector2(x + TILE * 0.5, floor_y), d.id, d.get("to", ""), d.get("look", "metal"), cell)
		"ladder":
			# A shaft from this floor down to the section below.
			var lad: Stairs = STAIRS_SCENE.instantiate()
			lad.position = Vector2(x, (cell.y + 1) * TILE)    # the landing (the floor lookup would fall down the shaft)
			lad.width = TILE * 2
			lad.height = _open_rows_below(cell) * TILE
			props.add_child(lad)
		"landmark":
			var lm: Node2D = LANDMARK_SCRIPT.new()
			lm.set("kind", d.kind)
			lm.set("trips", d.get("trips", {}))
			lm.position = Vector2(x + TILE * 0.5, floor_y - float(d.get("above_floor", 0)))
			props.add_child(lm)
			_landmarks.append(lm)
		"story":
			var sp: Node2D = STORY_SCRIPT.new()
			sp.set("kind", d.kind)
			sp.set("room_height", floor_y - ceil_y)
			sp.position = Vector2(x + TILE * 0.5, floor_y - float(d.get("above_floor", 0)))
			props.add_child(sp)
		"bgdoor", "bggrate":
			var bd: Node2D = BACK_DETAIL_SCRIPT.new()
			bd.set("kind", d.type)
			bd.position = Vector2(x + TILE * 0.5, cell.y * TILE + TILE * 0.5)
			props.add_child(bd)
		"switch":
			var lever: LeverSwitch = SWITCH_SCENE.instantiate()
			lever.position = Vector2(x + TILE * 0.5, floor_y)
			lever.switch_id = d.id
			lever.kills_light = d.get("kills", "")
			lever.flipped.connect(_on_switch_flipped)
			props.add_child(lever)
		"door":
			var door: HeavyDoor = DOOR2_SCENE.instantiate()
			door.position = Vector2(x + TILE * 0.5, floor_y)
			door.door_id = d.id
			door.height = floor_y - ceil_y
			door.open_seconds = float(d.get("open_seconds", 0.0))
			props.add_child(door)
			_doors[d.id] = door
		_:
			push_warning("TestLevel: unknown decor type '%s'" % d.type)


func _make_back_door(at: Vector2, id: String, to: String, look: String, cell: Vector2i) -> BackDoor:
	var door: BackDoor = BACK_DOOR_SCRIPT.new()
	door.door_id = id
	door.target = to
	door.look = look
	door.zone = zone_at(cell)
	door.level = self
	door.position = at
	props.add_child(door)
	_back_doors[id] = door
	return door


## The section a cell (or world point) is in, or {} (the shop, rock).
func section_at_cell(cell: Vector2i) -> Dictionary:
	var best := {}
	for sec: Dictionary in SECTIONS:
		if cell.x >= int(sec.x0) and cell.x < int(sec.x1) and cell.y >= int(sec.top) - 1 and cell.y <= int(sec.floor) + 1:
			best = sec
	return best


func section_at(pos: Vector2) -> Dictionary:
	return section_at_cell(Vector2i(int(floor(pos.x / TILE)), int(floor((pos.y - 2.0) / TILE))))


func zone_at(cell: Vector2i) -> int:
	var sec := section_at_cell(cell)
	return int(sec.zone) if not sec.is_empty() else 1


func back_door(id: String) -> BackDoor:
	return _back_doors.get(id, null)


## Through a back-wall door: a short fade, the door's sound, out at the other one.
func use_door(door: BackDoor) -> void:
	if _door_busy or GameState.player == null:
		return
	if door.door_id == "deeper":
		if descent.can_go_deeper():
			descent.go_deeper()
		else:
			door.rattle()
		return
	if door.is_locked() or not _back_doors.has(door.target):
		door.rattle()
		return
	_door_busy = true
	var dest: BackDoor = _back_doors[door.target]
	var p = GameState.player
	p.input_locked = true
	AudioDirector.play_at("creak", door.global_position, -12.0, 0.15, 420.0, 1.25)
	var ui = get_tree().current_scene.get_node("UI")
	await ui.fade_to(1.0, 0.22).finished
	p.global_position = dest.global_position
	p.velocity = Vector2.ZERO
	p.snap_camera()
	if dest.zone != GameState.zone:
		GameState.set_zone(dest.zone)
	AudioDirector.play_at("clunk", dest.global_position, -16.0, 0.1, 420.0, 1.1)
	await ui.fade_to(0.0, 0.3).finished
	p.input_locked = false
	_door_busy = false


## Return trips: the basement landing is a little different every time.
func _apply_landmark_changes(trip: int) -> void:
	for lm in _landmarks:
		lm.apply_trip(trip)
	if _back_doors.has("deeper"):
		_back_doors["deeper"].set_look("ajar" if trip >= 1 else "sealed")


## Foreground pipes, girders and cables: one or two per section.
func _build_foreground() -> void:
	foreground = FOREGROUND_SCRIPT.new()
	foreground.name = "Foreground"
	add_child(foreground)
	var kinds := ["pipe", "girder", "cables"]
	for i in SECTIONS.size():
		var sec: Dictionary = SECTIONS[i]
		var x0 := float(sec.x0) * TILE
		var w := float(int(sec.x1) - int(sec.x0)) * TILE
		var fy := float(int(sec.floor) + 1) * TILE
		foreground.add_item(x0 + w * 0.3, fy, kinds[i % 3])
		if w >= 22 * TILE:
			foreground.add_item(x0 + w * 0.78, fy, kinds[(i + 1) % 3])


## World y of the ceiling (underside of the rock) above an open cell.
func _ceiling_y(cell: Vector2i) -> float:
	var y := cell.y
	while _is_open(cell.x, y - 1):
		y -= 1
	return float(y * TILE)


## World y of the floor (top of the rock) below an open cell.
func _floor_y(cell: Vector2i) -> float:
	var y := cell.y
	while _is_open(cell.x, y + 1):
		y += 1
	return float((y + 1) * TILE)


## Solid rock around the map, so the camera never shows the void past the edge.
func _fill_margin(width: int) -> void:
	const MARGIN := 10
	for y in range(-MARGIN, MAP.size() + MARGIN):
		for x in range(-MARGIN, width + MARGIN):
			if y >= 0 and y < MAP.size() and x >= 0 and x < width:
				continue
			walls.set_cell(Vector2i(x, y), 0, _atlas(TileSetBuilder.ROCK, Vector2i(x, y)))


## Atlas coords for a tile type at a cell: a stable pseudo-random variant row
## (mostly plain, sometimes cracked or grimy) so the repeat isn't obvious.
func _atlas(tile_type: int, cell: Vector2i) -> Vector2i:
	var h := absi(cell.x * 73856093 ^ cell.y * 19349663) % 10
	var variant := 0
	if h >= 8:
		variant = 2
	elif h >= 6:
		variant = 1
	return Vector2i(tile_type, mini(variant, _variants - 1))


## Which solid tile a cell gets, from its open neighbours and the material of
## the room they belong to (TileSetBuilder.MATERIALS): open above = that room's
## floor, open below = its ceiling, open beside = a side wall, else rock.
func _solid_tile_for(x: int, y: int) -> int:
	if _is_open(x, y - 1):
		return TileSetBuilder.MATERIALS[_material_at(x, y - 1)][0]
	if _is_open(x, y + 1):
		return TileSetBuilder.MATERIALS[_material_at(x, y + 1)][1]
	for dx in [-1, 1]:
		if _is_open(x + dx, y):
			return TileSetBuilder.MATERIALS[_material_at(x + dx, y)][2]
	return TileSetBuilder.ROCK


## Back-wall cells along the floor or ceiling get the grimy edge versions:
## dirt collects in corners and edges, never across the middle of a wall.
func _back_edge(wall_type: int, cell: Vector2i) -> int:
	if not _is_open(cell.x, cell.y + 1):
		return TileSetBuilder.MATERIALS[wall_type][3]
	if not _is_open(cell.x, cell.y - 1):
		return TileSetBuilder.MATERIALS[wall_type][4]
	return wall_type


const OPEN_CHARS := ".,:;~"


## ":" shop tiles, "." storeroom concrete, "," tunnel brick, ";" zone 3 stone,
## "~" zone 4 flesh.
func _wall_for_char(ch: String) -> int:
	match ch:
		":":
			return TileSetBuilder.WALL_SHOP
		",":
			return TileSetBuilder.WALL_BRICK
		";":
			return TileSetBuilder.WALL_STONE
		"~":
			return TileSetBuilder.WALL_FLESH
	return TileSetBuilder.WALL_CONCRETE


## Back-wall material of an open cell (markers inherit from their left).
func _material_at(x: int, y: int) -> int:
	var row: String = MAP[y]
	var ch := row[x]
	if OPEN_CHARS.contains(ch):
		return _wall_for_char(ch)
	return _background_for(row, x)


func _is_open(x: int, y: int) -> bool:
	if y < 0 or y >= MAP.size():
		return false
	var row: String = MAP[y]
	if x < 0 or x >= row.length():
		return false
	return row[x] != "#" and row[x] != "%"


## Markers take the back-wall tile of the nearest open tile to their left.
func _background_for(row: String, x: int) -> int:
	for i in range(x - 1, -1, -1):
		if OPEN_CHARS.contains(row[i]):
			return _wall_for_char(row[i])
	return TileSetBuilder.WALL_CONCRETE


func _place_marker(ch: String, cell: Vector2i) -> void:
	var floor_point := Vector2(cell.x * TILE + TILE * 0.5, (cell.y + 1) * TILE)
	var centre := Vector2(cell.x * TILE + TILE * 0.5, cell.y * TILE + TILE * 0.5)
	match ch:
		"P":
			player_start = floor_point
		"B":
			panel = PANEL_SCENE.instantiate()
			panel.position = Vector2(cell.x * TILE, (cell.y + 1) * TILE)
			panel.board_ripped.connect(_on_board_ripped)
			props.add_child(panel)
		"H":
			var stairs: Stairs = STAIRS_SCENE.instantiate()
			stairs.position = Vector2(cell.x * TILE, (cell.y + 1) * TILE)
			stairs.width = TILE * 2
			stairs.height = _open_rows_below(cell) * TILE
			props.add_child(stairs)
			_main_stairs = stairs
		"W":
			thing = THING_SCENE.instantiate()
			thing.position = floor_point
			creatures.add_child(thing)
		"S":
			var shelf: Node2D = SHELF_SCENE.instantiate()
			shelf.position = floor_point
			props.add_child(shelf)
		"D":
			var door: Node2D = DOOR_SCENE.instantiate()
			door.position = floor_point
			props.add_child(door)
			_door_pos = floor_point
			_shop_bits["door"] = door
			_figure = FIGURE_SCRIPT.new() as CCTVFigure
			props.add_child(_figure)
		"F", "f":
			var sign_node: Node2D = SIGN_SCENE.instantiate()
			sign_node.position = centre
			sign_node.set("wrong", ch == "f")
			props.add_child(sign_node)
			sign_node.add_to_group("signs")
		"K":
			var task_shelf: Node2D = SHELF_SCENE.instantiate()
			task_shelf.position = floor_point
			props.add_child(task_shelf)
			_add_task("shelf", floor_point + Vector2(16, 0), ShopTask.Kind.BOX)
			_shop_bits["crisps"] = floor_point
		"R":
			var fridge: Node2D = FRIDGE_SCENE.instantiate()
			fridge.position = floor_point
			props.add_child(fridge)
			_shop_bits["fridge"] = fridge
			_add_task("fridge", floor_point, ShopTask.Kind.NONE, 1.0)
		"M":
			var mop: Node2D = MOP_SCENE.instantiate()
			mop.position = floor_point + Vector2(14, 0)
			props.add_child(mop)
			_shop_bits["mop"] = mop
			_add_task("mop", floor_point, ShopTask.Kind.SPILL, 2.0)
		"C":
			var counter: Node2D = COUNTER_SCENE.instantiate()
			counter.position = floor_point
			props.add_child(counter)
			_counter_pos = floor_point
			_add_task("torch", floor_point + Vector2(17, 0), ShopTask.Kind.NONE, 0.6, Vector2(14, 28))
			_add_task("cctv", floor_point + Vector2(-3, 0), ShopTask.Kind.NONE, 0.3, Vector2(14, 28), true)
		"X":
			var breaker: Node2D = BREAKER_SCENE.instantiate()
			breaker.position = centre + Vector2(0, -8)
			props.add_child(breaker)
			_add_task("breaker", floor_point, ShopTask.Kind.NONE, 0.5)
		_:
			if TRIGGERS.has(ch):
				_place_trigger(TRIGGERS[ch], floor_point)
			else:
				push_warning("TestLevel: unknown map marker '%s' at %s" % [ch, cell])


func _place_trigger(cfg: Dictionary, at: Vector2) -> void:
	var t: LevelTrigger = TRIGGER_SCENE.instantiate()
	t.position = at
	t.line_id = cfg.get("line", "")
	t.event_name = cfg.get("event", "")
	t.sets_checkpoint = cfg.get("checkpoint", false)
	t.zone = cfg.get("zone", -1)
	t.one_shot = not cfg.get("repeat", false)
	if cfg.get("after_power", false):
		t.armed = false
		_after_power.append(t)
	t.triggered.connect(_on_trigger)
	triggers.add_child(t)


func _add_task(id: String, at: Vector2, kind: ShopTask.Kind, hold := 1.5,
		zone := Vector2(28, 28), repeatable := false) -> void:
	var task: ShopTask = TASK_SCENE.instantiate()
	task.task_id = id
	task.kind = kind
	task.hold_time = hold
	task.zone_size = zone
	task.repeatable = repeatable
	task.position = at
	props.add_child(task)
	_tasks.append(task)


## Counts open (non-solid) tiles straight down from below the given cell.
func _open_rows_below(cell: Vector2i) -> int:
	var n := 0
	var y := cell.y + 1
	while y < MAP.size():
		var row: String = MAP[y]
		var ch := row[cell.x] if cell.x < row.length() else "#"
		if ch == "#" or ch == "%":
			break
		n += 1
		y += 1
	return n


# ---------------------------------------------------------------------- events

func _on_trigger(t: LevelTrigger) -> void:
	if t.event_name in ["climax", "last_stretch", "never_was", "ending"]:
		descent.on_event(t.event_name)
		return
	match t.event_name:
		"wake_thing":
			if thing != null:
				thing.activate()
		"hush":
			# Just before a scripted encounter: every ambient layer drops out.
			pacing.hush(randf_range(4.0, 8.0))
		"end":
			ending_reached.emit()


func _on_switch_flipped(switch_id: String) -> void:
	if _doors.has(switch_id):
		_doors[switch_id].open()
	# Lights out: some switches kill a nearby working light.
	for lever in props.get_children():
		if lever is LeverSwitch and lever.switch_id == switch_id and lever.kills_light != "":
			if _worklights.has(lever.kills_light):
				_worklights[lever.kills_light].set_power(false)


func _on_board_ripped(remaining: int) -> void:
	if remaining == panel.board_count - 1:
		Narrator.say("its_fine")
	elif remaining == 0:
		Narrator.say("dont_worry_boards")


func _apply_zone(zone: int, instant := false) -> void:
	var dark: Color = ZONE_DARKNESS.get(zone, ZONE_DARKNESS[2])
	if zone == 0 and act0.power_on:
		dark = POWER_ON_SHOP
	# (Ambience volume follows the zone in _update_silence.) Zone 4: the hum
	# drops into a low drone (the only "music": design doc).
	ambience.pitch_scale = 0.55 if zone >= 4 else 1.0
	var verb: Array = ZONE_REVERB.get(zone, ZONE_REVERB[2])
	AudioDirector.set_reverb(verb[0], verb[1])
	if instant:
		darkness.color = dark
		return
	create_tween().tween_property(darkness, "color", dark, 2.5)
