; Engine configuration file.
; Night Shift: milestone 1 vertical slice.

config_version=5

[application]

config/name="Night Shift"
config/description="Dark 2D semi-horror side-scroller. Vertical slice: torch, hidden creatures, the voice."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
AudioDirector="*res://autoload/audio_director.gd"
Narrator="*res://autoload/narrator.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0

